# SPA fallback for React Router (BrowserRouter).
# Serve real files/directories as-is; everything else falls back to
# index.html so client-side routes (e.g. /equipment, /calculator) don't
# 404 on a hard refresh or a direct link.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
